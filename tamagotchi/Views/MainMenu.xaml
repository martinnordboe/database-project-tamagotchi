<UserControl x:Class="tamagotchi.Views.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:tamagotchi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--<Grid x:Name="Background" Background="#80000000" Visibility="Visible" Grid.Row="0" Grid.Column="0">
            <Image Source="/Assets/Images/Background.png" Stretch="UniformToFill"  />
        </Grid>-->

        <Grid Background="Transparent" Grid.Row="0" Grid.Column="0" Panel.ZIndex="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="StartNewGame_Button" MinWidth="200" Width="300" Height="40" Grid.Row="0" Grid.Column="0" Background="LightCoral" Click="StartNewGame_Button_Click">Start New Game</Button>

            <Button x:Name="LoadGame_Button" MinWidth="200" Width="300" Height="40" Grid.Row="1" Grid.Column="0" Background="LightCoral" Click="LoadGame_Button_Click">Load Game</Button>

            <Button x:Name="Exit_Button" MinWidth="200" Width="300" Height="40" Grid.Row="2" Grid.Column="0" Background="LightCoral" Click="Exit_Button_Click">Exit</Button>


        </Grid>
    </Grid>
</UserControl>
