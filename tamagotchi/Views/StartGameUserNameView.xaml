<UserControl x:Class="tamagotchi.Views.StartGameUserNameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:tamagotchi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="400" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Background="White">
                <TextBlock FontSize="30" Width="300" TextAlignment="Center">Enter your name!</TextBlock>
                <TextBox x:Name="usernameTextbox" Width="300" Background="white" Height="50" FontSize="30" TextAlignment="Center"></TextBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BackButton" Width="300" Margin="10, 50" Background="LightBlue" Click="BackButton_Click">BACK</Button>
                    <Button x:Name="NextButton" Width="300" Margin="10, 50" Background="LightBlue" Click="NextButton_Click">NEXT</Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
