<Window x:Class="tamagotchi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tamagotchi"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid x:Name="Background" Background="#80000000" Visibility="Visible" Grid.Row="0" Grid.Column="0">
            <Image Source="/Assets/Images/Background.png" Stretch="UniformToFill"  />
        </Grid>

        <ContentControl Padding="10" x:Name="viewContent"></ContentControl>

    </Grid>
</Window>
